/*
 * Corne Choc Pro BT - ZMK Keymap
 * Converted from Vial layout
 *
 * Layer 0: QWERTY base
 * Layer 1: Numbers + Symbols  (MO1 = left inner thumb)
 * Layer 2: F-keys + Navigation (MO2 = right outer thumb)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";

            // -----------------------------------------------------------------------------------------
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  ESC |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |  B  |  ;   |  H  |  J  |  K  |  L  |  '  | RET  |
            // | GUI  | CTRL|  Z  |  X  |  C  |  V  |            |  N  |  M  |  ,  |  .  |  /  | SHFT |
            //                    | ALT | SPC | MO1 |            | SPC | SPC | MO2 |

            bindings = <
&kp TAB    &kp Q      &kp W  &kp E     &kp R      &kp T  &kp Y  &mo 3     &kp Y      &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A      &kp S  &kp D     &kp F      &kp G  &kp B  &kp SEMI  &kp H      &kp J      &kp K      &kp L    &kp SQT   &kp RET
&kp LGUI   &kp LCTRL  &kp Z  &kp X     &kp C      &kp V                   &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                             &kp LALT  &kp SPACE  &mo 1                   &kp SPACE  &kp SPACE  &mo 2
            >;
        };

        lower_layer {
            display-name = "NUM/SYM";

            // -----------------------------------------------------------------------------------------
            // | ESC  |  1  |  2  |  3  |  4  |  5  |  6  |  ESC |  6  |  7  |  8  |  9  |  0  | BSLH |
            // | SHFT |  7  |  8  |  9  |  0  |  |  | MUTE|  :   |  [  |  ]  |  -  |  =  |  `  | RET  |
            // | GUI  | CTRL| BrD | BrU | VlD | VlU |            |  _  |  +  |  ,  |  .  | BSLH| SHFT |
            //                    | SHFT| SHFT| --- |            | SPC | SPC | SHFT|

            bindings = <
&kp ESC    &kp N1     &kp N2        &kp N3        &kp N4        &kp N5        &kp N6      &kp ESC    &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSLH
&kp LSHFT  &kp N7     &kp N8        &kp N9        &kp N0        &kp PIPE      &kp C_MUTE  &kp COLON  &kp LBKT   &kp RBKT   &kp MINUS  &kp EQUAL  &kp GRAVE  &kp RET
&kp LGUI   &kp LCTRL  &kp C_BRI_DN  &kp C_BRI_UP  &kp C_VOL_DN  &kp C_VOL_UP                         &kp UNDER  &kp PLUS   &kp COMMA  &kp DOT    &kp BSLH   &kp RSHFT
                                    &kp LSHFT     &kp LSHFT     &trans                               &kp SPACE  &kp SPACE  &kp LSHFT
            >;
        };

        raise_layer {
            display-name = "F/NAV";

            // -----------------------------------------------------------------------------------------
            // | ESC  | F1  | F2  | F3  | F4  | F5  | F11 |      |     |     |     |     |     | DEL  |
            // | SHFT | F6  | F7  | F8  | F9  | F10 | F12 |      |     |     |     | UP  |     | INS  |
            // | GUI  | CTRL|     |     |     |     |            |     |     | LFT | DWN | RGT | SHFT |
            //                    | ALT | SPC |     |            | SPC | KP0 | --- |

            bindings = <
&kp ESC    &kp F1     &kp UP_ARROW    &kp F2     &kp F3     &kp F4   &kp F5  &bt BT_CLR_ALL  &bt BT_CLR  &bt BT_PRV  &bt BT_NXT      &none           &none           &kp DEL
&kp LSHFT  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &kp F6     &kp F7   &kp F8  &sys_reset      &none       &none       &mkp MB1        &mmv MOVE_UP    &mkp MB2        &kp INS
&kp LGUI   &kp LCTRL  &kp F9          &kp F10    &kp F11    &kp F12                          &none       &none       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_DOWN  &kp RSHFT
                                      &kp LALT   &kp SPACE  &none                            &kp SPACE   &kp KP_N0   &trans
            >;
        };

        layer_3 {
            bindings = <
&sys_reset      &trans  &bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&studio_unlock  &trans  &trans       &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                                     &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
